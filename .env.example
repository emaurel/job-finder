# --- LLM (required for scoring + cover letters) ---
ANTHROPIC_API_KEY=

# --- Job sources ---
# JobTech (Arbetsformedlingen) and RemoteOK need no key.
# Greenhouse / Lever / Ashby company boards need no key either.
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Delivery ---
# Gmail SMTP app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
FROM_NAME=Your Name
REPLY_TO=you@gmail.com

# Where the daily digest goes
RECIPIENT_EMAIL=you@gmail.com

# --- Safety rails ---
# Hard cap on applications sent per day, whatever the queue says.
MAX_SENDS_PER_DAY=10
# Never send without explicit approval. Leave as true.
REQUIRE_APPROVAL=true

# --- ATS browser automation ---
# Let the browser click Submit on Greenhouse/Lever/Ashby forms.
# OFF by default: approving an application queues it, it does not authorise a
# robot to submit it. Turn on only once you trust the filled screenshots.
ATS_SUBMIT=false
ATS_HEADLESS=true

# --- Score thresholds ---
# Defaults are 50 (write a cover letter) and 25 (show in the review UI).
SCORE_DRAFT_THRESHOLD=50
SCORE_SHOW_THRESHOLD=25
